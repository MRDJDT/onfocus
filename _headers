# Security headers for the static site (Cloudflare Pages). /api/* responses set their own.
# Everything is self-hosted; the only outside connections are Firebase (Firestore in London + teacher sign-in).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src 'self' https://onfocus-90d5a.firebaseapp.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

